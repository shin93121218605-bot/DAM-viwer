generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ScoringRecord {
  id                        Int      @id @default(autoincrement())
  scoringAiId               String   @unique
  requestNo                 String
  contentsName              String
  artistName                String
  dContentsName             String
  dArtistName               String
  damserial                 String   @default("")
  dataKind                  String   @default("")
  clubDamCardNo             String   @default("")
  entryCount                Int?
  analysisReportCommentNo   String?
  radarChartPitch           Float?
  radarChartStability       Float?
  radarChartExpressive      Float?
  radarChartVibratoLongtone Float?
  radarChartRhythm          Float?
  singingRangeHighest       String?
  singingRangeLowest        String?
  vocalRangeHighest         String?
  vocalRangeLowest          String?
  score                     Float?
  performedAt               DateTime
  fetchedAt                 DateTime @default(now())
  // Extended fields (from CSV)
  lastPerformKey                    Int?
  intonation                        Int?
  kobushiCount                      Int?
  shakuriCount                      Int?
  fallCount                         Int?
  timing                            Int?
  longtoneSkill                     Int?
  vibratoSkill                      Int?
  vibratoType                       Int?
  vibratoTotalSecond                Float?
  vibratoCount                      Int?
  accentCount                       Int?
  aiSensitivityMeterAdd             Int?
  aiSensitivityMeterDeduct          Int?
  aiSensitivityPoints               Int?
  aiSensitivityBonus                Float?
  nationalAverageTotalPoints        Float?
  nationalAveragePitch              Float?
  nationalAverageStability          Float?
  nationalAverageExpression         Float?
  nationalAverageVibratoAndLongtone Float?
  nationalAverageRhythm             Float?
  maxTotalPoints                    Float?

  @@index([requestNo])
  @@index([performedAt])
  @@index([contentsName])
}

model Setting {
  key   String @id
  value String
}
